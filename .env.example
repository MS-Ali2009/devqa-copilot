# DevQA Copilot Environment Configuration
# ==============================================================================
# SECURITY CRITICAL: Server-side ONLY. NEVER prefix with NEXT_PUBLIC_.
# Do NOT commit real API keys to git or include them in CI logs or issue trackers.
# ==============================================================================

# Required for live AI generations:
# OpenAI API Key (leave blank or use mock provider for safe CI / Preview deploys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: LLM Model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Force Mock Provider (true | false)
# When set to true, the application bypasses OpenAI API entirely and uses
# deterministic, zero-cost mock outputs. Recommended for CI and Vercel Previews!
FORCE_MOCK_PROVIDER=false

# Optional: Server Rate Limit per minute per IP instance (default: 20)
# NOTE: InMemory rate limiter protects single serverless instances; enable
# Vercel Deployment Protection to prevent unauthorized public invocations.
RATE_LIMIT_PER_MINUTE=20
