# ==============================================================================
# DevQA Copilot: Environment Configuration Template (100% Free Stack)
# ==============================================================================
# SECURITY NOTICE:
# - All keys listed here are SERVER-SIDE ONLY.
# - NEVER prefix secret keys with NEXT_PUBLIC_.
# - NEVER commit real secrets to GitHub or share in pull request comments.
# ==============================================================================

# ─── 1. AI Provider Configuration (Default: 100% Free Groq) ───────────────────
# Options: 'groq' | 'openai'
AI_PROVIDER=groq

# Groq Cloud API Key (Get free key at: https://console.groq.com/keys - No credit card required)
# Free limits: 30 requests/minute, 14,400 requests/day
GROQ_API_KEY=your-groq-api-key-here

# Groq Model: 'llama-3.3-70b-versatile' (recommended) or 'llama-3.1-8b-instant'
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Force Mock Provider (true | false)
# When set to true, bypasses AI calls and returns deterministic mock output.
# Recommended for CI pipelines and Vercel Preview deployments.
FORCE_MOCK_PROVIDER=false

# Optional: OpenAI Configuration (Only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── 2. Database: Supabase Free Tier ──────────────────────────────────────────
# Create a free project at: https://supabase.com (500MB DB, 50k MAU, no credit card)
# Find these under: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── 3. Simple Authentication & Sessions ──────────────────────────────────────
# Generate a strong 64-character secret using: openssl rand -base64 48
SESSION_SECRET=generate-a-secure-random-secret-key-at-least-32-chars-long

# Designated owner email address:
# The first signup matching this email will automatically receive the 'owner' role
OWNER_EMAIL=your-email@example.com

# ─── 4. Rate Limiting (Single Instance Defense) ────────────────────────────────
# In-memory sliding window request cap per IP per minute (default: 20)
RATE_LIMIT_PER_MINUTE=20
